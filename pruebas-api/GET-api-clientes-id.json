{
  "metodo": "GET",
  "ruta": "/api/clientes/{id}",
  "descripcion": "Consulta un cliente por su ObjectId.",
  "nota": "Reemplazar <ObjectIdCliente> por un id real de MongoDB.",
  "casos": [
    {
      "nombre": "Cliente encontrado",
      "peticion": "GET /api/clientes/<ObjectIdCliente>",
      "respuesta": {
        "codigo": 200,
        "cuerpo": {
          "id": "<ObjectIdCliente>",
          "nombre": "María García",
          "email": "maria.garcia@greencart.com"
        }
      }
    },
    {
      "nombre": "Cliente no existe o id inválido",
      "peticion": "GET /api/clientes/<ObjectIdInexistente>",
      "respuesta": {
        "codigo": 404,
        "cuerpo": {
          "error": "El cliente \"<ObjectIdInexistente>\" no existe."
        }
      }
    }
  ]
}